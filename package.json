{
  "name": "exegeomai",
  "version": "1.0.4",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --port 8082",
    "dev": "concurrently --kill-others-on-fail --raw \"npx expo start --port 8082\"",
    "android": "expo start --android --port 8082",
    "ios": "expo start --ios --port 8082",
    "web": "expo start --web --port 8082",
    "web:portal": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:start": "npm --prefix web run start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "test:ci": "jest --runInBand --ci",
    "doctor": "expo-doctor",
    "export:android": "expo export --platform android --output-dir dist-ci",
    "verify": "npm run typecheck && npm run test:ci && npm run doctor && npm run export:android"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "~57.0.28",
    "expo-file-system": "^57.0.7",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.22",
    "expo-screen-capture": "~57.0.4",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.26",
    "lucide-react-native": "^1.47.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-worklets": "0.10.1",
    "expo-splash-screen": "~57.0.9",
    "@noble/ciphers": "2.4.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.3",
    "concurrently": "^10.0.5",
    "jest": "~29.7.0",
    "ts-jest": "^29.4.14",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {
    "shell-quote": "1.11.0",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
